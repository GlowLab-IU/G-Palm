{
  "expo": {
    "name": "Palm Tree Counter",
    "slug": "palm-tree-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "palm-tree-counter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "plugins": [
        "expo-camera",
        "expo-camera"
      ],
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to capture your face for analysis.",
        "NSPhotoLibraryUsageDescription": "Allow picking photos for analysis."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97fbb181-b5d0-4c67-84cf-13ade1fdcdf9"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/97fbb181-b5d0-4c67-84cf-13ade1fdcdf9"
    }
  }
}
